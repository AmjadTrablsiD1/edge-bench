{
  "_comment": "RULE 11: the single source of truth. No literal number, path, port, timeout, limit or label may appear anywhere else in the codebase. Python reads this via app/constants.py, the UI imports it via ui/src/constants.ts.",
  "app": {
    "id": "edge-bench",
    "name": "Edge Bench",
    "version": "0.3.1",
    "icon": "⏱",
    "tagline": "Saleae edge timing — reference edge to every channel, out to Excel"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 0,
    "whoami_token": "edge-bench-1",
    "startup_timeout_s": 20,
    "probe_interval_s": 0.25,
    "browser_delay_s": 0.2,
    "dev_port": 8791,
    "lock_file": "instance.lock",
    "busy_probe_timeout_s": 5,
    "no_browser_env": "EDGE_BENCH_NO_BROWSER"
  },
  "paths": {
    "config_dir": "~/.config/edge-bench",
    "state_dir": "~/.local/state/edge-bench",
    "log_dir": "~/.local/state/edge-bench/logs",
    "cache_dir": "~/.cache/edge-bench"
  },
  "files": {
    "extensions": [
      ".sal",
      ".csv",
      ".bin"
    ],
    "dialog_title": "Add Saleae captures",
    "dialog_filetypes": [
      [
        "Saleae captures",
        "*.sal"
      ],
      [
        "Logic 2 digital CSV",
        "*.csv"
      ],
      [
        "Logic 2 binary export",
        "*.bin"
      ],
      [
        "All files",
        "*.*"
      ]
    ],
    "dialog_timeout_s": 600,
    "bin_glob": "digital_*.bin",
    "bin_index_regex": "digital[_-](\\d+)\\.bin$",
    "csv_time_header": "Time [s]",
    "csv_no_data": "X",
    "csv_chunk_rows": 500000,
    "csv_sample_bytes": 1048576
  },
  "binary": {
    "magic": "<SALEAE>",
    "type_digital": 0,
    "supported_versions": [
      0,
      1
    ]
  },
  "logic2": {
    "user_port": 10430,
    "own_port_first": 10440,
    "own_port_tries": 20,
    "connect_timeout_s": 60,
    "export_complete_timeout_s": 600,
    "export_poll_s": 0.2,
    "export_stable_polls": 3,
    "cli_args": [
      "--automation",
      "--automationPort"
    ],
    "candidates": {
      "Windows": [
        "%ProgramW6432%\\Logic\\Logic.exe",
        "%ProgramFiles%\\Logic\\Logic.exe",
        "%LOCALAPPDATA%\\Programs\\Logic\\Logic.exe"
      ],
      "Darwin": [
        "/Applications/Logic2.app/Contents/MacOS/Logic",
        "/Applications/Saleae Logic.app/Contents/MacOS/Logic",
        "~/Applications/Logic2.app/Contents/MacOS/Logic"
      ],
      "Linux": [
        "~/Logic.AppImage",
        "/opt/saleae/Logic"
      ]
    },
    "probe_channels": [
      16,
      8,
      4
    ],
    "min_free_disk_gb": 5,
    "watch_interval_s": 1.0,
    "job_memory_frac": 0.6
  },
  "cache": {
    "max_gb": 20,
    "key_version": 2
  },
  "measure": {
    "edge_kinds": [
      "rising",
      "falling",
      "any"
    ],
    "ref_modes": [
      "manual",
      "auto"
    ],
    "default_ref_mode": "manual",
    "default_ref_edge": "rising",
    "default_target_edge": "any",
    "default_occurrence": 1,
    "max_occurrence": 1000000,
    "glitch_walk_limit": 100000,
    "statuses": {
      "ok": "Edge found",
      "no_edge": "No edge after reference",
      "out_of_window": "No edge inside window",
      "reference": "Reference",
      "excluded": "Excluded",
      "no_data": "No data at reference"
    }
  },
  "waveform": {
    "max_exact_per_px": 2,
    "min_px": 50,
    "max_px": 8000,
    "default_span_factor": 1.25,
    "lane_px": 34,
    "lane_gap_px": 8,
    "label_gutter_px": 132,
    "axis_px": 26,
    "high_frac": 0.18,
    "low_frac": 0.82,
    "zoom_step": 1.25,
    "min_span_s": 1e-09
  },
  "units": {
    "time": [
      {
        "label": "s",
        "scale": 1
      },
      {
        "label": "ms",
        "scale": 0.001
      },
      {
        "label": "µs",
        "scale": 1e-06
      },
      {
        "label": "ns",
        "scale": 1e-09
      }
    ],
    "default_export_unit": "µs"
  },
  "excel": {
    "filename_suffix": "_edges.xlsx",
    "batch_filename": "edge_bench_batch.xlsx",
    "sheet_results": "Results",
    "sheet_matrix": "Batch matrix",
    "sheet_settings": "Settings",
    "header_fill": "1F3A5F",
    "header_font": "FFFFFF",
    "ref_fill": "FFF2CC",
    "miss_fill": "FDE2E1",
    "col_width": 16,
    "name_col_width": 26
  },
  "ui": {
    "default_theme": "midnight",
    "min_window_width": 900,
    "motion_ms": 150,
    "toast_ms": 4500,
    "poll_ms": 400,
    "heartbeat_ms": 2000,
    "heartbeat_misses": 2,
    "rail_px": 248,
    "inspector_px": 330,
    "results_px": 236,
    "storage_prefix": "edge-bench"
  },
  "quantities": {
    "_comment": "Hue lives in themes.json as --q-<name>. Reference trace, measured edge marker, delta annotation and ordinary trace each keep one hue across the app.",
    "trace": {
      "unit": "",
      "word": "teal",
      "dash": [
        null,
        [
          8,
          3
        ],
        [
          2,
          3
        ]
      ]
    },
    "ref": {
      "unit": "",
      "word": "gold",
      "dash": [
        null,
        [
          6,
          3
        ],
        [
          2,
          3
        ]
      ]
    },
    "edge": {
      "unit": "s",
      "word": "blue",
      "dash": [
        null,
        [
          4,
          3
        ],
        [
          2,
          3
        ]
      ]
    },
    "busy": {
      "unit": "",
      "word": "teal",
      "dash": [
        null,
        null,
        null
      ]
    }
  },
  "compare": {
    "_comment": "Each limit is 'absolute or relative, whichever is larger' (a timing spec's usual '±1 µs or ±5 %'), and never below resolution_floor_samples sample periods (each edge time is ±1 sample). Delays (ms scale) and pulse widths (ns scale) get separate limits: one shared absolute limit would hide every nanosecond pulse change.",
    "time_abs_s": 1e-06,
    "time_rel": 0.05,
    "pulse_abs_s": 1e-08,
    "pulse_rel": 0.1,
    "count_abs": 2,
    "count_rel": 0.1,
    "duty_abs": 0.05,
    "duty_min_edges": 3,
    "resolution_floor_samples": 2,
    "verdicts": {
      "same": "Same",
      "changed": "Changed",
      "critical": "Critical",
      "excluded": "Excluded",
      "missing": "Not in both"
    },
    "sheet_compare": "Comparison",
    "sheet_a": "Baseline (A)",
    "sheet_b": "New (B)",
    "filename": "edge_bench_compare.xlsx",
    "match_modes": [
      "number",
      "name"
    ],
    "default_match": "number",
    "span_chunk_edges": 4000000,
    "summary_block_edges": 4096,
    "summary_min_edges": 2000000,
    "quick_show_ms": 400
  },
  "guard": {
    "_comment": "Edge Bench stops itself before it can take the PC down: if its own private memory passes this share of the physical RAM it writes crash.log, says why and exits. Memory-mapped capture files do not count (they are file-backed and the OS can drop them).",
    "max_private_frac": 0.5,
    "interval_s": 1.0
  },
  "sal_native": {
    "_comment": "Direct .sal reader (app/readers/sal_native.py). Logic 2's own channel files: undocumented, decoded from Logic 2.4.48 files and checked against its binary exports. Anything else falls back to the Logic 2 export. Decoding needs ~30x its input in temporary arrays, so it works on pieces and blocks of 256 kB and on at most batch_marks marks at a time. Blocks are indexed on up to max_workers threads.",
    "magic": "<SALEAE>",
    "version": 4,
    "type": 100,
    "header_flag": 1,
    "member_regex": "^digital-(\\d+)\\.bin$",
    "piece_bytes": 262144,
    "split_window_bytes": 16384,
    "block_bytes": 262144,
    "decoded_cache_mb": 256,
    "max_token_bytes": 9,
    "copy_chunk_bytes": 1048576,
    "cache_kind": "native-3",
    "max_workers": 6,
    "header_max_bytes": 128,
    "chunk_max_bytes": 268435456,
    "pair_rounds": 8,
    "pair_slices": 4096,
    "mark_every": 4096,
    "cache_span_marks": 8,
    "batch_marks": 64
  },
  "update": {
    "_comment": "In-place updates (updater.py). The install folder holds only replaceable program files plus the 'keep' entries; settings, logs and caches live in the home folder, so an update never touches them.",
    "package_regex": "^EdgeBench-(\\d+(?:\\.\\d+)*)-windows(-offline)?\\.zip$",
    "version_regex": "^\\d+(\\.\\d+)*$",
    "manifest": "MANIFEST.json",
    "changelog": "CHANGELOG.md",
    "work_dir": ".update",
    "keep": [
      ".venv",
      ".update",
      ".git"
    ],
    "deps_stamp": "edge-bench-requirements.sha256",
    "settings_key": "update_folder",
    "log_name": "update.log",
    "server_exit_timeout_s": 30,
    "check_timeout_s": 180,
    "move_retry_s": 5,
    "recent_failure_s": 900,
    "dialog_title": "Choose an Edge Bench update (.zip)",
    "dialog_filetypes": [
      [
        "Edge Bench update",
        "*.zip"
      ],
      [
        "All files",
        "*.*"
      ]
    ]
  }
}
